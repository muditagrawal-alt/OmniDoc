# Copy to .env and fill in what you use. Every key below is optional; with none set,
# OmniDoc uses local Ollama models. The first hosted provider with a key answers, the
# others take over when it is rate-limited (order: OMNIDOC_LLM_PROVIDERS).

# --- Language models (free tiers) --------------------------------------------
# https://aistudio.google.com/apikey  (Gemini 3.5 Flash / Flash-Lite; vision; embeddings)
GEMINI_API_KEY=
# https://console.groq.com/keys       (gpt-oss-120b / 20b, very fast; Whisper transcripts)
GROQ_API_KEY=
# https://build.nvidia.com            (one key for every model; ~40 requests/min per model)
NVIDIA_API_KEY=
# https://console.mistral.ai/api-keys (free Experiment plan)
MISTRAL_API_KEY=
# https://openrouter.ai/keys          (models ending in :free)
OPENROUTER_API_KEY=
# https://cloud.cerebras.ai           (trial credit)
CEREBRAS_API_KEY=
# GitHub token with models:read       (low daily limits)
GITHUB_MODELS_TOKEN=
# OMNIDOC_LLM_PROVIDERS=gemini,groq,nvidia      # fallback order
# OMNIDOC_MODEL=gemini:gemini-3.5-flash         # the default model (also switchable in the app)
# GEMINI_MODEL=gemini-3.5-flash                 # per-provider overrides: <NAME>_MODEL, <NAME>_FAST_MODEL, <NAME>_BASE_URL
# Any other OpenAI-compatible endpoint:
# OMNIDOC_LLM_BASE_URL=  OMNIDOC_LLM_API_KEY=  OMNIDOC_LLM_MODEL=

# --- Embeddings ----------------------------------------------------------------
# Default: nomic-embed-text in Ollama when it runs, else a hosted model, else a small local
# CPU model (st:intfloat/multilingual-e5-small). Changing it re-indexes in the background.
# OMNIDOC_EMBED_MODEL=st:intfloat/multilingual-e5-small
# JINA_API_KEY=          # https://jina.ai/embeddings (free starter tokens)

# --- Web search (DuckDuckGo works without a key) ----------------------------------
# https://app.tavily.com  (1,000 searches/month free)
TAVILY_API_KEY=
# BRAVE_API_KEY=         # https://brave.com/search/api ($5 monthly credit, card needed)
# SERPER_API_KEY=        # https://serper.dev (2,500 free searches, once)
# SEARXNG_URL=           # your own SearXNG instance
# OMNIDOC_WEB_SEARCH=auto   # auto | on | off

# --- Deployment ------------------------------------------------------------------
# OMNIDOC_AUTH=me:a-long-random-password   # asks every visitor for this (use HTTPS)
# OMNIDOC_HOST=0.0.0.0
# OLLAMA_HOST=http://ollama:11434
