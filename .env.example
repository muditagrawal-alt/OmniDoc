# Copy to .env and fill in what you use. Every key below is optional; with none set,
# OmniDoc uses local Ollama models. The first hosted provider with a key answers, the
# others take over when it is rate-limited (order: OMNIDOC_LLM_PROVIDERS).

# --- Language models (free tiers) --------------------------------------------
# https://aistudio.google.com/apikey  (Gemini 3.5 Flash-Lite, ~500 requests/day; vision; embeddings)
GEMINI_API_KEY=
# https://console.groq.com/keys       (gpt-oss-120b / 20b, very fast; Whisper transcripts)
GROQ_API_KEY=
# https://build.nvidia.com            (one key for every model; ~40 requests/min per model)
NVIDIA_API_KEY=
# https://console.mistral.ai/api-keys (free Experiment plan)
MISTRAL_API_KEY=
# https://openrouter.ai/keys          (models ending in :free)
OPENROUTER_API_KEY=
# https://cloud.cerebras.ai           (trial credit)
CEREBRAS_API_KEY=
# GitHub token with models:read       (low daily limits)
GITHUB_MODELS_TOKEN=
# OMNIDOC_LLM_PROVIDERS=gemini,groq,nvidia      # fallback order
# OMNIDOC_MODEL=gemini:gemini-3.5-flash-lite    # the default model (also switchable in the app)
# GEMINI_MODEL=gemini-3.5-flash-lite            # per-provider overrides: <NAME>_MODEL, <NAME>_FAST_MODEL, <NAME>_BASE_URL
# Any other OpenAI-compatible endpoint:
# OMNIDOC_LLM_BASE_URL=  OMNIDOC_LLM_API_KEY=  OMNIDOC_LLM_MODEL=

# --- Embeddings ----------------------------------------------------------------
# Default: nomic-embed-text in Ollama when it runs, else a hosted model, else a small local
# CPU model (st:intfloat/multilingual-e5-small). Changing it re-indexes in the background.
# OMNIDOC_EMBED_MODEL=st:intfloat/multilingual-e5-small
# JINA_API_KEY=          # https://jina.ai/embeddings (free starter tokens)

# --- Web search (DuckDuckGo works without a key) ----------------------------------
# https://app.tavily.com  (1,000 searches/month free)
TAVILY_API_KEY=
# BRAVE_API_KEY=         # https://brave.com/search/api ($5 monthly credit, card needed)
# SERPER_API_KEY=        # https://serper.dev (2,500 free searches, once)
# SEARXNG_URL=           # your own SearXNG instance
# OMNIDOC_WEB_SEARCH=auto   # auto | on | off

# --- Accounts (a hosted OmniDoc with sign-in; see deploy/README.md) --------------
# Without these OmniDoc is a single-user app: no sign-in, one library.
# OMNIDOC_ACCOUNTS=1
# OMNIDOC_PUBLIC_URL=https://omnidoc.example.com      # the address users open (Google/GitHub return here)
# OMNIDOC_ADMIN_EMAILS=you@example.com                # no limits; may change the server's model (needs two-step sign-in)
# OMNIDOC_ADMIN_CODE=                                 # setup code that makes a signed-in account the administrator
#                                                     # (Settings, Administer this server); without it one is made and
#                                                     # printed to the log at start-up until someone claims the role
# OMNIDOC_ALLOWED_EMAILS=                             # optional: only these addresses or @domains may sign in (turns passkey sign-up off)
# Passkeys (on by default with accounts): sign-up and sign-in with Face ID, Touch ID, Windows Hello or a phone, no e-mail
# OMNIDOC_PASSKEYS=1
# Passwords (on by default with accounts): a username and password instead of a passkey; "forgot password" is a
# recovery code and a new password (no e-mail). Stored as scrypt hashes. Off when OMNIDOC_ALLOWED_EMAILS is set.
# OMNIDOC_PASSWORDS=1
# OMNIDOC_RP_ID=                                      # default: the host of OMNIDOC_PUBLIC_URL ("localhost" for an IP)
# Guest demo: "Try it without signing in" on a shared, read-only sample library (put its files in <data>/demo)
# OMNIDOC_DEMO=1
# OMNIDOC_GUEST_QUESTIONS=20                          # questions per guest session per day (with their own key)
# OMNIDOC_DEMO_DIR=                                   # the demo's documents (images ship a fictional sample library)
# Free trial, then bring your own key: answers on the server's keys before a user needs their own free key
# OMNIDOC_TRIAL_ANSWERS=3                             # per account and per guest, over its lifetime
# OMNIDOC_TRIAL_PER_IP=9                              # per network address per day, across accounts
# OMNIDOC_GUESTS_PER_IP=4                             # guest sessions per address per day
# Abuse limits (no third-party service): a proof-of-work check on sign-up, demo and recovery codes, and requests per address
# OMNIDOC_POW_MAX=80000                               # puzzle size; about a second in a browser
# OMNIDOC_API_PER_MINUTE=240
# Slim server for 1 GB hosts (deploy/Dockerfile.slim sets these): ONNX models instead of PyTorch
# OMNIDOC_EMBED_MODEL=onnx:Xenova/bge-small-en-v1.5
# OMNIDOC_RERANKER_MODEL=onnx:Xenova/ms-marco-MiniLM-L-6-v2
# OMNIDOC_ONNX_THREADS=1                              # the container's CPUs
# OMNIDOC_GRAPH_MEMORY_MB=96
# E-mail through any SMTP service (free: Gmail with an app password, 500/day; Brevo, 300/day). Used for the
# operator's feedback notices and, unless OMNIDOC_EMAIL_SIGNIN=0, for e-mailed sign-in codes.
# OMNIDOC_SMTP_HOST=smtp.gmail.com
# OMNIDOC_SMTP_PORT=587
# OMNIDOC_SMTP_USER=you@gmail.com
# OMNIDOC_SMTP_PASSWORD=                              # a Gmail app password, not your account password
# OMNIDOC_SMTP_FROM=OmniDoc <you@gmail.com>
# OMNIDOC_EMAIL_SIGNIN=0                              # keep SMTP for your own notices only: no sign-in codes to visitors
# OMNIDOC_FEEDBACK_EMAIL=you@gmail.com                # every piece of feedback from the product page, at once
# RESEND_API_KEY=                                     # Resend (free, 3,000/month): sends those e-mails instead of SMTP;
#                                                     # without a domain only to the Resend account's own address
# OMNIDOC_RESEND_FROM=OmniDoc <onboarding@resend.dev> # another sender once a domain is verified in Resend
# OMNIDOC_FEEDBACK_EMAILS_PER_HOUR=30                 # beyond this, feedback is only kept in the Admin tab
# OMNIDOC_GRAVATAR=1                                  # 0: no Gravatar pictures for accounts with an e-mail address
# Google and GitHub sign-in (free OAuth apps; callback: <PUBLIC_URL>/api/auth/oauth/<google|github>/callback)
# OMNIDOC_GOOGLE_CLIENT_ID=
# OMNIDOC_GOOGLE_CLIENT_SECRET=
# OMNIDOC_GITHUB_CLIENT_ID=
# OMNIDOC_GITHUB_CLIENT_SECRET=
# Limits per account (administrators have none)
# OMNIDOC_DAILY_QUESTIONS=40
# OMNIDOC_DAILY_UPLOADS=20
# OMNIDOC_STORAGE_MB=200
# OMNIDOC_SESSION_DAYS=30

# --- Deployment ------------------------------------------------------------------
# OMNIDOC_AUTH=me:a-long-random-password   # asks every visitor for this (use HTTPS)
# OMNIDOC_HOST=0.0.0.0
# OLLAMA_HOST=http://ollama:11434
