# OmniDoc for 1 GB servers (ClawCloud Run's free plan): the same app and web interface as the main
# Dockerfile, without PyTorch or Ollama. Embeddings and reranking are small int8 ONNX models baked
# into the image (retrieval/onnx_models.py); answers come from free hosted model APIs or the
# user's own key. Build from the repository root:
#
#   docker build -f deploy/Dockerfile.slim -t omnidoc:slim .
#
# Data (library, indexes, uploads, accounts) lives in /data: mount a persistent volume there.

# ---- 1. Web app --------------------------------------------------------------
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# ---- 2. Server ---------------------------------------------------------------
FROM python:3.11-slim

# MALLOC_*: glibc returns large freed buffers (page renders, model activations) to the system at
# once, and two arenas stop threads from each holding their own free memory.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OMNIDOC_DATA_DIR=/data \
    OMNIDOC_HOST=0.0.0.0 \
    OMNIDOC_PORT=8000 \
    HF_HOME=/data/cache/huggingface \
    OMNIDOC_ONNX_CACHE=/opt/onnx \
    OMNIDOC_EMBED_MODEL=onnx:Xenova/bge-small-en-v1.5 \
    OMNIDOC_RERANKER_MODEL=onnx:Xenova/ms-marco-MiniLM-L-6-v2 \
    OMNIDOC_ONNX_THREADS=1 \
    OMNIDOC_GRAPH_MEMORY_MB=96 \
    OMNIDOC_LOCAL_FALLBACK=0 \
    MALLOC_ARENA_MAX=2 \
    MALLOC_TRIM_THRESHOLD_=131072 \
    MALLOC_MMAP_THRESHOLD_=131072

# OCR (with Indian languages), audio extraction for transcripts, Pango for PDF reports. These cost
# disk, not memory: Tesseract and ffmpeg run as short-lived processes.
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr tesseract-ocr-osd tesseract-ocr-eng tesseract-ocr-hin tesseract-ocr-mar tesseract-ocr-ben \
        tesseract-ocr-tam tesseract-ocr-tel tesseract-ocr-kan tesseract-ocr-guj tesseract-ocr-pan tesseract-ocr-mal \
        ffmpeg libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fonts-dejavu-core fonts-noto-core curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-slim.txt .
RUN pip install -r requirements-slim.txt

COPY . .
COPY --from=web /web/dist /app/frontend/dist
# The two ONNX models (about 60 MB) ship in the image, so a fresh server needs no download, and so
# does the demo's sample library (five documents about a fictional company: deploy/demo/make_samples.py).
RUN python -c "from retrieval import onnx_models; onnx_models.warm()" \
    && python deploy/demo/make_samples.py /opt/demo
ENV OMNIDOC_DEMO_DIR=/opt/demo

RUN useradd --create-home --uid 1000 omnidoc && mkdir -p /data && chown -R omnidoc:omnidoc /data /app /opt/onnx /opt/demo
USER omnidoc

EXPOSE 8000
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s CMD curl -fs http://127.0.0.1:8000/api/health || exit 1
CMD ["python", "server.py"]
